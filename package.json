{
  "name": "mofa-stage-desktop",
  "version": "0.6.7",
  "description": "MoFA Stage Desktop - AI Agent Development Platform",
  "main": "electron/main.js",
  "author": "MoFA Team",
  "license": "Apache-2.0",
  "scripts": {
    "kill-ports": "lsof -ti:3000,5001,5002 | xargs -r kill -9 || true",
    "install-all": "npm install && cd frontend && npm install",
    "dev": "npm run kill-ports && npm run install-all && concurrently \"npm run backend:dev\" \"npm run frontend:dev\" \"wait-on http://localhost:3000 http://localhost:5002 && NODE_ENV=development electron .\"",
    "version:patch": "npm version patch && git push --follow-tags",
    "version:minor": "npm version minor && git push --follow-tags",
    "version:major": "npm version major && git push --follow-tags",
    "frontend:dev": "cd frontend && npm run dev",
    "backend:dev": "cd backend && ${PYTHON_CMD:-python3} app.py",
    "frontend:build": "cd frontend && npm run build",
    "backend:build": "python3 scripts/build_backend.py",
    "build": "npm run frontend:build && npm run backend:build",
    "electron:pack": "electron-builder",
    "dist": "npm run build && electron-builder --publish=never",
    "release": "npm run build && electron-builder --publish=always",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.mofa.stage.desktop",
    "productName": "MoFA Stage",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "publish": {
      "provider": "github",
      "owner": "mofa-org",
      "repo": "mofa-stage",
      "releaseType": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "assets/**/*",
      "scripts/**/*",
      "README.md",
      "README_cn.md",
      "LICENSE",
      "package.json",
      "!frontend/node_modules/**/*",
      "!backend/backend_venv/**/*",
      "!backend/__pycache__/**/*",
      "!backend/temp/**/*",
      "!backend/logs.duckdb",
      "!node_modules/**/*",
      "!dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/",
        "to": "backend/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "compression": "maximum",
    "generateUpdatesFilesForAllChannels": false
  }
}
